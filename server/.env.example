# Environment Variables Template for Backend (Render)

# Server Port (Render sets this automatically, default 5000 for local)
PORT=5000

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/propertybills?retryWrites=true&w=majority

# JWT Secret Key for Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Frontend URL for CORS configuration (comma separated if multiple)
CLIENT_URL=https://propertybills.vercel.app

# Email credentials for automated due date reminders & notifications
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
